# --- MacBook browser worker configuration (§27) ---
# Copy to .env.worker and fill in. NEVER commit .env.worker.
# The worker needs only what it needs — no DB URL, no LLM keys (semantic answers are
# generated by the Render API, §28), no user passwords.

# The deployed Render API base URL (https). The worker calls IN to this.
API_BASE_URL=https://adaptive-resume-api.onrender.com

# Shared worker token — must equal WORKER_AUTH_TOKEN set on the Render service (§13).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_AUTH_TOKEN=

# Optional. Defaults to mac-<hostname>. Handy if you run more than one worker.
WORKER_ID=

# Optional tuning. Poll cadence and idle back-off cap (seconds), and headless toggle.
WORKER_POLL_SECONDS=5
WORKER_IDLE_MAX_SECONDS=30
WORKER_HEADLESS=true
