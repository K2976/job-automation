# --- Adaptive Resume Engineer configuration ---
# Copy to .env and fill in. Never commit .env.

# Where the SQLite knowledge base lives (V1 uses SQLite, not Postgres — see ADR-001).
DATABASE_URL=data/adaptive_resume.sqlite3

# LLM provider: mock | gemini | groq
# "mock" is fully offline and deterministic — the default so the app runs with no keys.
LLM_PROVIDER=mock
LLM_MODEL=                       # optional override; provider picks a sensible default

GEMINI_API_KEY=
GROQ_API_KEY=

# Embedding provider: local | gemini
# "local" is an offline TF-IDF embedder (no torch) — see ADR-004.
EMBEDDING_PROVIDER=local

# Retrieval tuning (hybrid: semantic + keyword)
RETRIEVAL_TOP_K=8
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# Upload limits (bytes) and allowed resume types
MAX_UPLOAD_BYTES=5242880

# --- V2: opportunity discovery ---
# Enabled source adapters (comma-separated): fixtures | greenhouse | lever
# Greenhouse + Lever are official no-auth JSON feeds (real live jobs) and the default.
# Use "fixtures" for fully offline runs (no network/keys) — it serves demo example.com jobs.
OPPORTUNITY_SOURCES=greenhouse,lever
# Board tokens / company slugs for the live sources (comma-separated). Sensible defaults
# ship in config.py; set these to override. An adapter is only built when its list is non-empty.
GREENHOUSE_BOARDS=
LEVER_BOARDS=
# Pipeline sizing: opportunities reaching LLM JD analysis, and the shortlist size.
DISCOVERY_DEEP_TOP_N=15
DISCOVERY_SHORTLIST_N=10

# Allowed CORS origins (comma-separated) for split deployment (frontend on a different
# host than the API). "*" for local/dev. On Render set this to your Vercel URL.
# Note: CORS is not a security boundary — see docs/deployment.md.
CORS_ORIGINS=*
